# ==========================================
# CONFIGURAÇÕES SUPABASE - VETLINE
# ==========================================
# Preencha com as credenciais do seu projeto Supabase:
# Acesse: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_INFOSIMPLES_TOKEN=your-infosimples-token
VITE_JUCESP_LOGIN_CPF=your-govbr-cpf
VITE_JUCESP_LOGIN_SENHA=your-govbr-password

# ==========================================
# CONFIRMAÇÃO VIA WHATSAPP (Z-API) & SUPABASE ADMIN
# ==========================================
# Chave Service Role (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Credenciais da Instância Z-API (Painel Z-API)
ZAPI_INSTANCE_ID=your-zapi-instance-id
ZAPI_TOKEN=your-zapi-token
ZAPI_CLIENT_TOKEN=your-zapi-client-token-optional
